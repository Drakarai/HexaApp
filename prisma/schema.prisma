// HexaApp — gestor de competiciones tipo "Hexalocke"
// SQLite no soporta enums en Prisma, por eso los campos de tipo enumerado son String
// y los valores válidos están centralizados en src/lib/constants.ts

generator client {
  provider        = "prisma-client-js"
  // Los `include` en una sola consulta con JOIN, y no una por relación: cada
  // una era otra ida y vuelta a la base de datos, que está en internet
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // La que usa la aplicación para atender páginas. Con el pooler de Neon, es
  // la que lleva "-pooler" en el nombre del servidor.
  url       = env("DATABASE_URL")
  // La directa, solo para crear tablas al publicar: eso no funciona a través
  // del pooler. Si no se configura, scripts/preparar-build.mjs la iguala a la
  // de arriba, que es lo correcto cuando no hay pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y sesiones
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  displayName      String
  passwordHash     String
  // "ADMIN" | "PLAYER". Los admin globales pueden crear competiciones y usuarios.
  role             String   @default("PLAYER")
  /**
   * Permiso de **organizador**: puede montar sus propios lockes y dar de alta a
   * la gente que juega con él, sin ver los lockes de los demás.
   * Es una marca aparte y no un rol nuevo a propósito: un organizador no es
   * medio administrador global —no toca el catálogo de objetos, ni los mapas,
   * ni las copias de seguridad, ni ve un locke en el que no juega—, solo se le
   * levanta la puerta de "crear". Lo da y lo quita un administrador global.
   */
  puedeCrearLockes Boolean  @default(false)
  /**
   * La versión de las sesiones de esta cuenta. Va dentro de cada cookie de
   * sesión y, si no coincide, la sesión ya no vale: subirla **echa a la cuenta
   * de todos los dispositivos** a la vez. Sube al cambiar la contraseña y con
   * «Cerrar sesión en los demás dispositivos» (ver `lib/auth.ts`).
   */
  sesionVersion    Int      @default(0)
  /**
   * Quién dio de alta esta cuenta, si la dio un organizador.
   * Hace falta para que un organizador pueda arreglar lo suyo —cambiarle la
   * contraseña a alguien de su grupo, borrar una cuenta que creó mal— sin poder
   * tocar las cuentas del resto de la casa. En las cuentas que creó un
   * administrador global va vacío.
   */
  creadoPorId      String?
  creadoPor        User?    @relation("CuentasCreadas", fields: [creadoPorId], references: [id], onDelete: SetNull)
  cuentasCreadas   User[]   @relation("CuentasCreadas")
  avatarColor      String   @default("#6366f1")
  // Foto de perfil: URL externa o imagen subida (data URL ya redimensionada)
  avatarImage      String?
  // Tema de color elegido, uno por juego principal. Ver src/lib/themes.ts
  theme            String   @default("hexa")
  /**
   * A quién ha quitado de su palmarés. Se guardan los quitados y no los
   * elegidos a propósito: así quien empiece a jugar con él aparece solo, sin
   * tener que ir a añadirlo.
   */
  palmaresOcultos  String[] @default([])
  createdAt        DateTime @default(now())

  participations         Participant[]
  notes                  Note[]
  pointsGiven            PointEntry[]     @relation("PointAuthor")
  spins                  RouletteSpin[]
  competitions           Competition[]    @relation("CompetitionCreator")
  ticketsGiven           RouletteTicket[] @relation("TicketAuthor")
  titles                 TitleAward[]     @relation("TitleOwner")
  titlesGiven            TitleAward[]     @relation("TitleGiver")
  visitas                TabSeen[]
  espectador             Spectator[]
  solicitudes            LockeRequest[]   @relation("SolicitanteDeLocke")
  solicitudesResueltas   LockeRequest[]   @relation("ResolutorDeLocke")
  sugerencias            Sugerencia[]
  lockesDeAntesGanados   LockeDeAntes[]   @relation("GanadorDeAntes")
  lockesDeAntesSegundo   LockeDeAntes[]   @relation("SubcampeonDeAntes")
  lockesDeAntesApuntados LockeDeAntes[]   @relation("ApuntadorDeAntes")
}

/**
 * Cuándo miró alguien por última vez una pestaña.
 * Es lo único que hace falta para el punto de "hay algo nuevo aquí": lo nuevo
 * se calcula comparando esta fecha con la de lo que ha pasado, así que no hay
 * que guardar una lista de novedades por persona ni marcar nada como leído
 * pieza a pieza. Va por edición porque cada Hexalocke se sigue por su cuenta.
 */
model TabSeen {
  id            String   @id @default(cuid())
  userId        String
  competitionId String
  /**
   * El rótulo del grupo del menú: "Combates", "La edición" o "Lo mío".
   */
  tab           String
  seenAt        DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([userId, competitionId, tab])
}

// ---------------------------------------------------------------------------
// Títulos
// ---------------------------------------------------------------------------

/**
 * Un título que un administrador se inventa y reparte: "Rey del cementerio",
 * "El que nunca falla". **Es puramente estético**, no da puntos ni ventajas.
 * Van en el usuario y no en el participante para que sigan a la persona de una
 * edición a otra.
 */
model Title {
  id          String   @id @default(cuid())
  name        String
  /**
   * Qué significa. Sale al pasar por encima de la chapa.
   */
  description String?
  /**
   * Un emoji, para que la chapa se reconozca de un vistazo
   */
  icon        String?
  color       String   @default("#a78bfa")
  createdAt   DateTime @default(now())

  awards TitleAward[]
}

/**
 * Que a alguien le hayan dado un título, con el porqué.
 */
model TitleAward {
  id          String   @id @default(cuid())
  titleId     String
  userId      String
  /**
   * Por qué se lo ha llevado. Lo escribe quien lo concede.
   */
  note        String?
  /**
   * Si es el que lleva puesto ahora mismo, el que sale debajo de su nombre.
   * Solo puede haber uno encendido por persona; de eso se encarga la acción de
   * equipar, que apaga los demás en la misma transacción. Se guarda aquí y no
   * en `User` para no meter una clave foránea circular entre las dos tablas.
   */
  equipped    Boolean  @default(false)
  awardedAt   DateTime @default(now())
  awardedById String?

  title     Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  user      User  @relation("TitleOwner", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy User? @relation("TitleGiver", fields: [awardedById], references: [id], onDelete: SetNull)

  // El mismo título dos veces a la misma persona no aporta nada
  @@unique([titleId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Mapas de las regiones
// ---------------------------------------------------------------------------

/**
 * El mapa de una región (Johto, Kanto…). **Es global, no de cada edición**: el
 * mapa de Johto vale igual para un locke en Oro que para uno en HeartGold, y
 * así se edita una vez y sirve para siempre.
 * Los mapas viven en la base de datos y no en el código a propósito: se editan
 * desde Administración, y un nombre mal traducido o una zona que falte se
 * arregla ahí en vez de esperar a que alguien toque el programa. De
 * `lib/mapas-de-fabrica.ts` solo se copian la primera vez.
 */
model MapRegion {
  id      String  @id @default(cuid())
  /**
   * "johto", "kanto"… El identificador de lib/juegos.ts
   */
  slug    String  @unique
  name    String
  /**
   * La imagen del mapa, si alguien la sube: las chinchetas se pintan encima.
   * Es opcional y el esquema funciona igual sin ella.
   */
  image   String?
  /**
   * Tamaño del lienzo sobre el que se colocan las zonas
   */
  width   Int     @default(1490)
  height  Int     @default(890)
  /**
   * Cuánto se rellenan las zonas, en tanto por ciento. Con un mapa dibujado a
   * mano interesa el 100; con una imagen detallada —las islas de Alola— se baja
   * para que las zonas queden como puntos encima sin tapar el dibujo.
   */
  relleno Int     @default(100)

  zones MapZone[]
}

/**
 * Un sitio del mapa donde se puede capturar algo: una ruta, una cueva…
 * Cada zona es una **forma dibujada sobre el mapa**, y se pinta transparente
 * hasta que apuntas algo dentro; entonces se rellena de su color. Por eso no
 * lleva el nombre escrito encima: el mapa se vería lleno de etiquetas y ya no
 * se vería el mapa. El nombre sale al tocarla.
 * Una zona puede **llevar otras dentro** (`parentId`): una ciudad que además
 * tiene su propia zona capturable aparte. Entonces la forma del padre no se
 * captura directamente; al tocarla salen las hijas para elegir.
 */
model MapZone {
  id        String  @id @default(cuid())
  regionId  String
  name      String
  /**
   * "ruta" | "ciudad" | "cueva" | "bosque" | "agua" | "otro". Solo es color.
   */
  kind      String  @default("ruta")
  /**
   * Qué forma tiene sobre el mapa: "rect", "circulo" (redondo), "circle"
   * (óvalo, se llama así porque es el nombre que ya estaba guardado), "poly"
   * o "none".
   * Las de "none" no salen dibujadas, solo en la lista de zonas.
   */
  shape     String  @default("rect")
  /**
   * Esquina superior izquierda del recuadro que la contiene
   */
  x         Int
  y         Int
  w         Int     @default(150)
  h         Int     @default(44)
  /**
   * Solo para "poly": los vértices, en JSON `[[x,y], …]` del lienzo
   */
  points    String?
  /**
   * Grados que está girada sobre su centro. Hay rutas que van en diagonal y un
   * rectángulo recto encima de ellas se come media ciudad de al lado.
   */
  angle     Int     @default(0)
  /**
   * Color propio. Si no lo tiene, se usa el de su tipo (ver lib/zonas.ts)
   */
  color     String?
  /**
   * Si cuelga de otra zona, cuál. Las hijas no se dibujan: viven en su padre.
   */
  parentId  String?
  /**
   * Si es **otro trozo de una ruta partida**, de cuál: la ruta empieza, en medio
   * hay algo que ocupa su sitio, y sigue al otro lado. Un trozo solo es dibujo
   * —su forma y su sitio—: no sale en ninguna lista, no se captura en él y al
   * tocarlo se abre su ruta, con su color y lo que lleves apuntado en ella. Se
   * va con ella si se borra.
   */
  trozoDeId String?
  position  Int     @default(0)

  region   MapRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  parent   MapZone?  @relation("ZonaPadre", fields: [parentId], references: [id], onDelete: SetNull)
  children MapZone[] @relation("ZonaPadre")
  trozoDe  MapZone?  @relation("Trozos", fields: [trozoDeId], references: [id], onDelete: Cascade)
  trozos   MapZone[] @relation("Trozos")
  captures Capture[]
  deaths   Death[]

  @@index([regionId, position])
  @@index([parentId])
  @@index([trozoDeId])
}

/**
 * Una captura apuntada por un jugador en su mapa.
 * **Es privada como las notas**: se consulta y se borra siempre filtrando por
 * el participante de quien mira, y no hay ninguna pantalla que enseñe las de
 * otro, tampoco a los administradores.
 * `zoneId` va vacío en las capturas extra, que son las que no salen de una zona
 * del mapa (un regalo, un intercambio, una captura de premio).
 */
model Capture {
  id            String   @id @default(cuid())
  participantId String
  zoneId        String?
  species       String
  nickname      String?
  /**
   * Sprite de caja, descargado al guardar como en el resto de la aplicación
   */
  image         String?
  /**
   * Si se escapó, se murió al capturarlo o lo que sea que pasara
   */
  notes         String?
  /**
   * Que **no** se pudo capturar: se escapó, se murió, o el encuentro se falló.
   * La ruta cuenta como hecha pero sin premio, y en el mapa sale una ✕ en vez
   * del número. No impide apuntar después una captura buena en la misma zona:
   * en cuanto la hay, manda ella y la ✕ pasa a ser un número.
   */
  failed        Boolean  @default(false)
  /**
   * Qué pokémon es de verdad (el número de PokéAPI, forma incluida), para sus
   * tipos y sus evoluciones. Las de antes no lo tienen y se saca del nombre.
   */
  pokemonId     Int?
  /**
   * Dónde se capturó, escrito a mano: para los juegos sin mapa (un fangame
   * desde cero) o lo que no está en él.
   */
  sitio         String?
  /**
   * Dónde lo lleva ahora: `"equipo"` o `"caja"`, y en qué hueco. En la caja el
   * hueco es global (el 31 es el primero de la caja 2). Ver `lib/equipo-y-caja.ts`.
   */
  lugar         String   @default("caja")
  hueco         Int      @default(0)
  /**
   * El **vínculo** del Soul Link: las capturas de distintos jugadores que
   * comparten este valor van juntas, y si cae una caen todas. Vale lo mismo
   * para dos jugadores que para cuatro. Sin él, va suelta.
   */
  vinculo       String?
  /**
   * Si ya ha caído, su baja del cementerio. Borrar la baja lo resucita.
   * Sin `@unique` a propósito aunque sea una baja por captura: añadir una
   * restricción única obliga a `db push` a pedir permiso para perder datos, y
   * el despliegue se pararía ahí.
   */
  deathId       String?
  /**
   * Lo que le ha pasado por el camino y no se puede sacar de otro sitio, para
   * su historia (ver lib/historia.ts): de momento, **sus evoluciones**, como
   * `{ tipo: "evoluciona", de, a, fecha }`. Lo demás —jornadas, MVP, hall,
   * la caída— ya está en sus tablas. Va en la foto de deshacer: si se le da a
   * la B, la evolución tampoco pasó en su historia.
   */
  historia      Json     @default("[]")
  /**
   * Si es **shiny**: capturado así (la casilla de Shiny al apuntarlo) o vuelto
   * shiny después, que es uno de los premios. Su sprite es el variocolor, y al
   * evolucionar sigue siéndolo.
   */
  shiny         Boolean  @default(false)
  /**
   * La **ficha completa**, toda opcional: naturaleza, objeto que lleva y sus
   * cuatro movimientos. Se guardan los identificadores de PokéAPI ("adamant",
   * "leftovers", ["thunderbolt", …]), que son los de Showdown; ver
   * lib/movimientos.ts. Sin nivel, a propósito.
   */
  naturaleza    String?
  objeto        String?
  movimientos   Json     @default("[]")
  /**
   * Su **habilidad** (el identificador de PokéAPI, o «anil-…» en Añil; ver
   * lib/habilidades.ts) y, aparte, la de **su mega**: con la megapiedra puesta
   * se enseña la mega y la habilidad que se edita es esta, que empieza vacía la
   * primera vez (ver lib/megas.ts). Quitarle la piedra devuelve la de siempre.
   */
  habilidad     String?
  habilidadMega String?
  createdAt     DateTime @default(now())

  participant Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  zone        MapZone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  muerte      Death?         @relation(fields: [deathId], references: [id], onDelete: SetNull)
  // Los jugadores que la tienen de as (uno, el suyo)
  esAsDe      Participant[]  @relation("AsDelJugador")
  /**
   * Los equipos de combate en los que su dueño dijo que era este (ver MatchPokemon.captureId)
   */
  enCombates  MatchPokemon[] @relation("EnCombates")

  @@index([participantId])
  @@index([zoneId])
  @@index([vinculo])
  @@index([deathId])
}

/**
 * Lo que se puede **deshacer** en el equipo y la caja: mover, evolucionar,
 * vincular o dar por muerto. Se guarda cómo estaban las capturas tocadas
 * antes del cambio (`antes`, una lista de sus campos) y qué bajas creó, para
 * volver atrás de una en una. Se quedan las últimas veinte de cada jugador.
 */
model CambioDeCaja {
  id            String   @id @default(cuid())
  participantId String
  // "Evolucionar a Quilava", para el botón de deshacer
  descripcion   String
  antes         Json
  muertes       String[] @default([])
  // Las capturas que creó el cambio (leer la partida): deshacer las borra
  capturas      String[] @default([])
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, createdAt])
}

// ---------------------------------------------------------------------------
// Bolsa
// ---------------------------------------------------------------------------

/**
 * Un objeto que puede acabar en la bolsa de alguien. Hay de dos clases y se
 * guardan igual:
 * - Los del juego, elegidos de la lista de PokéAPI: llegan con su `apiSlug` y
 * el servidor se baja el dibujo al crearlos, así que después la aplicación no
 * depende de que GitHub siga en pie.
 * - Los inventados ("Captura extra", "Objeto competitivo"), con la imagen que
 * suba el administrador.
 * El catálogo es **global y no de cada edición**, como los títulos: "Captura
 * extra" significa lo mismo en el Hexalocke 3 que en el 2 y no tiene sentido
 * volver a crearlo cada vez. Las bolsas sí son de cada participante.
 */
model Item {
  id          String   @id @default(cuid())
  name        String
  /**
   * Para qué sirve. Sale debajo del nombre en la bolsa.
   */
  description String?
  /**
   * El objeto en PokéAPI. Único para no tener dos veces la misma Poké Ball.
   */
  apiSlug     String?  @unique
  /**
   * La imagen ya reducida (data URL), venga de la lista o subida a mano
   */
  image       String?
  /**
   * Si es un **grupo**: al usarlo no se gasta y ya, sino que sale la lista de
   * lo que lleva dentro para elegir con qué te quedas ("Objeto competitivo" →
   * Globo Helio, Casco Dentado…).
   * Se guarda aparte de tener o no `options` porque un grupo recién creado
   * todavía no tiene ninguno, y aun así hay que saber que es un grupo: si no,
   * se gastaría sin preguntar nada.
   */
  isGroup     Boolean  @default(false)
  createdAt   DateTime @default(now())

  options       ItemOption[]
  entries       BagEntry[]
  uses          BagUse[]
  premios       ChallengePrize[]
  // Las casillas de ruleta que lo reparten, y los giros en los que ya tocó
  casillas      RouletteOption[]
  girosDeRuleta RouletteSpin[]
}

/**
 * Una de las cosas entre las que se elige al gastar un objeto: "Captura extra"
 * lleva dentro las tres rutas que puedes repetir, y al usarlo eliges una.
 * Un objeto sin opciones se gasta directamente, sin preguntar nada.
 */
model ItemOption {
  id       String  @id @default(cuid())
  itemId   String
  name     String
  apiSlug  String?
  image    String?
  position Int     @default(0)

  item Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uses BagUse[] @relation("UsoElegido")

  @@index([itemId, position])
}

/**
 * Lo que alguien tiene en la bolsa. Solo lo ve su dueño y los administradores,
 * que son los únicos que pueden añadir y quitar.
 */
model BagEntry {
  id            String   @id @default(cuid())
  participantId String
  itemId        String
  quantity      Int      @default(1)
  /**
   * Apunte del administrador: de dónde salió, hasta cuándo vale…
   */
  note          String?
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Un objeto ocupa una fila con su cantidad, no una fila por unidad
  @@unique([participantId, itemId])
  @@index([participantId])
}

/**
 * Que alguien haya gastado un objeto. Es lo que sale en el muro de actividad:
 * la bolsa es privada, pero **usar** algo se anuncia, que para eso cuenta.
 * Guarda copiado el nombre de lo usado porque los enlaces se ponen a null si el
 * objeto desaparece del catálogo: el historial tiene que aguantar eso.
 */
model BagUse {
  id            String   @id @default(cuid())
  participantId String
  itemId        String?
  itemName      String
  optionId      String?
  optionName    String?
  usedAt        DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  item        Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  option      ItemOption? @relation("UsoElegido", fields: [optionId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([usedAt])
}

// ---------------------------------------------------------------------------
// Competiciones
// ---------------------------------------------------------------------------

model Competition {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  // Juego / edición sobre la que se juega ("Pokémon HeartGold y SoulSilver")
  game                String?
  /**
   * El juego elegido de la lista de `lib/juegos.ts` ("heartgold"). De aquí sale
   * la región, y de la región el mapa de capturas.
   * Convive con `game`, que es texto libre, y no lo sustituye: las ediciones de
   * antes de que existiera la lista siguen enseñando lo que se escribió a mano.
   */
  gameId              String?
  /**
   * Un juego **no oficial** (un fangame: Pokémon Añil, Pokémon Z…). Entonces
   * `game` es su nombre, y `gameId`, si lo hay, es solo **el juego en el que se
   * basa**: de él salen el mapa de capturas y la plantilla de level caps, pero
   * no su nombre ni sus versiones. Sin base, se empieza de cero y no hay mapa.
   */
  juegoNoOficial      Boolean   @default(false)
  /**
   * Qué tipos se usan: `"antiguos"` (los de la generación del juego: sin Hada,
   * Clefairy Normal) o `"actuales"` (los de ahora). Solo se elige en juegos de
   * la 1ª a la 5ª y en fangames sin base; vacío es lo de cada uno (ver
   * `generacionDeTipos` en lib/juegos.ts).
   */
  tipos               String?
  // Modalidad ("Random", "Nuzlocke clásico", ...)
  modality            String?
  description         String?
  // "ACTIVE" | "ARCHIVED"
  status              String    @default("ACTIVE")
  // Puntos con los que arranca cada participante
  startingPoints      Int       @default(5)
  maxPlayers          Int       @default(6)
  /**
   * El estilo de juego: `"competitivo"` (el de siempre, contra los demás) o
   * `"soullink"` (cooperativo: las capturas de cada ruta van vinculadas y si
   * cae una caen todas). Se puede cambiar después de crearlo; ver
   * `lib/perfiles-de-locke.ts`, que es quien dice qué cambia con cada uno.
   */
  estilo              String    @default("competitivo")
  /**
   * Si la diferencia de pokémon de los combates de reto cuenta para el
   * desempate de la clasificación. Los retos nunca dan puntos; esto solo
   * decide si su diferencia entra en el tercer criterio.
   */
  challengeDiffCounts Boolean   @default(false)
  /**
   * En el dualocke: si **las jornadas pueden dar el título aunque se pierda el
   * juego**. Encendido (lo de siempre), gana quien llegue a la mayoría de
   * jornadas aunque luego pierda el locke. Apagado, manda pasarse el juego:
   * ver `campeonPorElJuego` en lib/campeon.ts.
   */
  jornadasDanTitulo   Boolean   @default(true)
  /**
   * **Locke con vidas**: cuántos pokémon se le pueden morir a cada uno antes de
   * perder el locke. Vacío es sin vidas, lo de siempre. Cuentan las bajas del
   * cementerio que no se han revivido; ver lib/vidas.ts.
   */
  vidas               Int?
  /**
   * Si se juega con **vida 0**: al llegar a cero se sigue, y es la siguiente
   * baja la que hace perder. Con 20 vidas, 21 bajas en vez de 20.
   */
  vidaCero            Boolean   @default(false)
  /**
   * La clave del **enlace público** de la clasificación (`/clasificacion/<clave>`),
   * o null si no hay. Para que la siga gente de fuera sin cuenta: solo enseña
   * la tabla. Larga y al azar, así que no se adivina; cambiarla deja
   * inservible la de antes. La crea y la quita quien lleva el locke.
   * Con índice y **no `@unique`**: añadir una restricción única hace que
   * `prisma db push` pida `--accept-data-loss`, y el build de Vercel lo lanza
   * sin él, así que el despliegue se pararía. Que no se repita ya lo asegura
   * el azar (32 letras).
   */
  enlacePublico       String?
  /**
   * Cuántas jornadas se van a jugar en total, si se sabe de antemano.
   * Hace falta para los lockes que se ganan **por jornadas** y no por puntos
   * (el dualocke): "gana el que se lleve 4 de las 6" solo se puede calcular
   * sabiendo que son seis. Las jornadas se van creando sobre la marcha, así que
   * contar las que hay daría un número que cambia y podría coronar a alguien
   * antes de tiempo. Sin rellenar se usa las que haya creadas.
   */
  jornadasPrevistas   Int?
  /**
   * Las ilustraciones del final del locke —el cartel de la Final Four—, que
   * salen de fondo en el resumen cuando ya no quedan level caps que superar.
   * Es una lista como las medallas de un gimnasio, y por lo mismo: se alternan.
   * Viven aquí y no en `FinalFour` porque se pueden poner **antes** de que haya
   * cuadro, que es justo cuando la tarjeta del resumen empieza a enseñarlas.
   */
  finalImages         String[]  @default([])
  /**
   * El logo de la edición, que sale de fondo junto a su nombre en el resumen.
   * Una imagen suelta, al almacén como las demás (ver lib/imagenes.ts).
   */
  logo                String?
  startedAt           DateTime  @default(now())
  /**
   * Creado pero **sin empezar**: para montarlo con tiempo sin que corran los
   * días. Al empezarlo desde Ediciones, `startedAt` pasa a ser ese día, que es
   * de donde cuenta lo que duró el locke.
   */
  sinEmpezar          Boolean   @default(false)
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdById String?
  createdBy   User?   @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  participants Participant[]
  rules        RuleSection[]
  levelCaps    LevelCap[]
  matchdays    Matchday[]
  roulettes    Roulette[]
  notes        Note[]
  pointEntries PointEntry[]
  finalFour    FinalFour?
  tickets      RouletteTicket[]
  challenges   ChallengeMatch[]
  visitas      TabSeen[]
  espectadores Spectator[]
  sorteos      Sorteo[]
  papelera     JornadaBorrada[]

  @@index([enlacePublico])
}

/**
 * Permiso de **solo mirar** una edición concreta.
 * Un locke lo ven sus jugadores (los de ahora y los de antes), los
 * administradores globales y quien tenga una fila aquí. Es por edición y no una
 * marca en `User` a propósito: el administrador decide qué locke enseña y a
 * quién, no abre todos de golpe.
 */
model Spectator {
  id            String   @id @default(cuid())
  userId        String
  competitionId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([userId, competitionId])
}

model Participant {
  id             String    @id @default(cuid())
  competitionId  String
  userId         String
  // Nombre mostrado dentro de esta competición (mote/nick del jugador)
  displayName    String
  // Edición del juego que le tocó ("HeartGold" / "SoulSilver")
  gameVersion    String?
  color          String    @default("#6366f1")
  // Admin de esta competición concreta (puede editar reglas, ruletas y puntos)
  isAdmin        Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  /**
   * Cuándo se retiró del locke, si es que se retiró.
   * **No se le borra nada**: su cementerio, sus puntos y sus combates jugados
   * siguen ahí, y la clasificación lo sigue enseñando, tachado y al final. Lo
   * único que cambia es que deja de contar para lo que hace avanzar al grupo
   * —los gimnasios, el MVP, los emparejamientos nuevos— y que sus combates
   * pendientes se dan por perdidos.
   * Es reversible: si vuelve, se le quita la marca. Los combates que ya se
   * hayan dado por retirada no se deshacen solos.
   * **Ojo**: esta fecha significa "cuándo dejó de competir", no solo "cuándo se
   * retiró". Un locke perdido por wipeo también la lleva; lo que los distingue
   * es `motivoDeSalida`.
   */
  retiredAt      DateTime?
  /**
   * Por qué está fuera: `"retirada"` si lo dejó, `"wipeo"` si perdió el locke.
   * Vacío mientras siga jugando.
   * Se hace así, y no con una segunda fecha, **a propósito**: para el locke las
   * dos salidas son la misma cosa —deja de entrar en emparejamientos, no cuenta
   * para el MVP ni para el formato del final, y sus combates pendientes los gana
   * el rival—, y toda esa maquinaria ya pregunta por `retiredAt`. Con una fecha
   * aparte habría que repasar quince consultas y bastaría olvidarse de una para
   * que alguien que perdió el locke siguiera emparejándose. Aquí la diferencia
   * es solo cómo se cuenta, que es justo lo que se quería distinguir.
   */
  motivoDeSalida String?

  // Pokémon as: el representante del jugador en esta edición. Va aquí y no en
  // User para que cada competición conserve el suyo cuando se archiva.
  aceSpecies      String?
  aceNickname     String?
  // Por qué es su as. Opcional, para lucirse en la ficha.
  aceReason       String?
  aceImage        String?
  aceDetailImage  String?
  /**
   * La captura del Equipo y PC que es su as. **El as se elige de la caja**, y
   * con esto se sabe cuál es: los campos de arriba son una copia de ella que
   * se pone al día sola cuando evoluciona, cambia de mote, se vuelve shiny o
   * se intercambia (ver lib/as-servidor.ts), para que todo lo que ya leía el
   * as —la clasificación, el cementerio, su imagen— siga igual. Null en los de
   * antes, que eran una especie escrita a mano.
   */
  aceCaptureId    String?
  // Quién ha sido su as y por qué dejó de serlo: ver lib/as.ts
  historialDeAses Json    @default("[]")

  // El fondo de cada caja de su Equipo y PC, separados por comas (ver
  // lib/fondos-de-caja.ts). Vacío: el de fábrica de cada caja.
  fondosDeCaja  String?
  // El nombre de cada caja, si se le ha puesto: una lista con una posición
  // por caja y null donde se queda con «Caja N» (ver lib/fondos-de-caja.ts)
  nombresDeCaja Json    @default("[]")

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aceCapture  Capture?    @relation("AsDelJugador", fields: [aceCaptureId], references: [id], onDelete: SetNull)

  deaths            Death[]
  wipeos            Wipeo[]
  pointEntries      PointEntry[]
  gymClears         GymClear[]
  gymVideos         GymVideo[]
  notesAbout        Note[]               @relation("NoteSubject")
  matchesAsA        Match[]              @relation("MatchPlayerA")
  matchesAsB        Match[]              @relation("MatchPlayerB")
  matchesWon        Match[]              @relation("MatchWinner")
  finalsWon         FinalMatch[]         @relation("FinalMatchWinner")
  hallOfFame        HallOfFameEntry[]
  tickets           RouletteTicket[]
  premiosRuleta     RouletteSpin[]       @relation("PremioDeRuleta")
  matchTeams        MatchPokemon[]
  mvpVotes          MvpVote[]            @relation("MvpVoter")
  favorites         FavoritePokemon[]
  challengesA       ChallengeMatch[]     @relation("ChallengePlayerA")
  challengesB       ChallengeMatch[]     @relation("ChallengePlayerB")
  challengesWon     ChallengeMatch[]     @relation("ChallengeWinner")
  bag               BagEntry[]
  bagUses           BagUse[]
  captures          Capture[]
  cambiosDeCaja     CambioDeCaja[]
  royales           RoyalePuesto[]
  sorteos           SorteoParticipante[]
  aportadosASorteos SorteoPokemon[]      @relation("SorteoAportadoPor")
  tocadosEnSorteos  SorteoPokemon[]      @relation("SorteoTocaA")
  equipoDeTipos     TypeTeam?

  @@unique([competitionId, userId])
  @@index([competitionId])
}

// ---------------------------------------------------------------------------
// Reglas y level caps
// ---------------------------------------------------------------------------

model RuleSection {
  id             String    @id @default(cuid())
  competitionId  String
  title          String
  // Texto de la sección. Se admite una sintaxis ligera: líneas que empiezan por
  // "- " se renderizan como lista y **texto** en negrita.
  body           String
  // Agrupador opcional ("Básicas", "Jornadas", "Puntos"...)
  category       String?
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /**
   * Cuándo cambió **de verdad** con el locke ya en marcha: la regla que se
   * añade o se reescribe cuando ya se está jugando. Enciende el punto de
   * novedades de Reglas. No sirve `updatedAt`, que también cambia al
   * reordenar, al corregir una errata sin avisar o al montar las reglas antes
   * de empezar, y eso no es noticia para nadie.
   */
  cambiadaAt     DateTime?
  /**
   * Quién la cambió: a él no hace falta avisarle
   */
  cambiadaPorId  String?
  /**
   * Lo que decía antes del último cambio, para poder enseñarlo. Vacío en una
   * sección añadida con el locke empezado: antes no decía nada.
   */
  tituloAnterior String?
  textoAnterior  String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, position])
}

model LevelCap {
  id             String   @id @default(cuid())
  competitionId  String
  // Nombre del líder / hito ("Pegaso", "Alto Mando", "Liga Pokémon")
  label          String
  cap            Int
  // "GYM" | "ELITE_FOUR" | "CHAMPION" | "OTHER"
  kind           String   @default("GYM")
  badge          String?
  notes          String?
  // Medallas o retratos: si hay más de una, se van alternando con un fundido.
  // Cada una es una URL o una imagen subida (data URL ya redimensionada).
  images         String[] @default([])
  // Legado de cuando solo se admitía una imagen. Se sigue leyendo como
  // respaldo si "images" está vacío, y se vacía al guardar desde el formulario.
  image          String?
  position       Int      @default(0)
  /**
   * Checkpoint de jornada: cuando todos hayan pasado este hito, toca jugar la
   * jornada antes de seguir, y la portada enseña el rival en vez del level cap
   * siguiente. Qué jornada es sale del orden (ver lib/checkpoints.ts).
   */
  jornadaDespues Boolean  @default(false)

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  clears      GymClear[]
  videos      GymVideo[]
  equipos     MatchPokemon[]

  @@index([competitionId, position])
}

// Marca de "gimnasio superado" por participante, para saber quién va por dónde
/**
 * La plantilla de level caps de un juego: los gimnasios, pruebas y hitos que
 * trae de serie, para no escribirlos a mano en cada locke.
 * **Es global, como los mapas**, y por eso no cuelga de ninguna edición: los
 * gimnasios de Johto son los mismos en Oro que en HeartGold. Se edita desde
 * Administración y de `lib/level-caps-de-fabrica.ts` solo se copia la primera
 * vez, con un botón; después manda lo que haya aquí guardado.
 * Va por **juego** y no por región a propósito: Platino no tiene los mismos
 * niveles que Diamante, y así se pueden separar sin tocar el otro.
 */
model LevelCapTemplate {
  id      String @id @default(cuid())
  /**
   * El grupo de juegos que comparte esta plantilla ("oro-plata"), de
   * `GRUPOS_DE_PLANTILLA` en lib/juegos.ts.
   * La columna se sigue llamando `gameId` porque antes guardaba el juego suelto,
   * y renombrarla haría que `prisma db push` la viera como borrar una y crear
   * otra: eso avisa de posible pérdida de datos y **para el despliegue en seco**,
   * que es la protección que se montó a propósito. El `@map` deja el nombre
   * viejo en la base de datos y el bueno en el código.
   */
  grupoId String @unique @map("gameId")

  items LevelCapTemplateItem[]
}

model LevelCapTemplateItem {
  id         String   @id @default(cuid())
  templateId String
  label      String
  cap        Int
  /**
   * Las medallas o los retratos del líder, ya reducidos (data URL), igual que
   * en `LevelCap`. Se guardan aquí para que un locke nuevo salga **con las
   * imágenes puestas** en vez de tener que subirlas cada edición.
   */
  images     String[] @default([])
  /**
   * "GYM" | "ELITE_FOUR" | "CHAMPION" | "OTHER", igual que en LevelCap
   */
  kind       String   @default("GYM")
  notes      String?
  position   Int      @default(0)

  template LevelCapTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
}

/**
 * La petición de alguien para abrir su propio **locke en solitario**.
 * Crear ediciones es cosa de administradores, y así se queda: si cualquiera
 * pudiera, el selector de competiciones acabaría lleno de pruebas a medias.
 * Pero un locke de una persona no le quita el sitio a nadie, así que en vez de
 * ir a pedírselo al administrador por WhatsApp se pide desde la aplicación y él
 * lo acepta o lo rechaza con un botón.
 * Al aceptarla se crea la competición y **el que la pidió entra como su único
 * jugador y administrador de esa edición**: es su partida, así que se apaña
 * solo con sus level caps y sus reglas.
 */
model LockeRequest {
  id             String    @id @default(cuid())
  userId         String
  name           String
  /**
   * El juego de lib/juegos.ts, si eligió uno de la lista
   */
  gameId         String?
  /**
   * Para un juego no oficial: su nombre (ver `Competition.juegoNoOficial`)
   */
  game           String?
  juegoNoOficial Boolean   @default(false)
  modality       String?
  description    String?
  /**
   * Para cuánta gente se pide el locke. **1 es el de uno mismo**, que es para
   * lo único que valía esto al principio; de 2 en adelante es un locke de
   * grupo, y quien lo pide se lleva además el permiso de organizador para dar
   * de alta a sus amigos.
   */
  /**
   * /**
   * /** "competitivo" o "soullink", como `Competition.estilo`. Uno solo es siempre lo primero
   */
  estilo         String    @default("competitivo")
  maxPlayers     Int       @default(1)
  /**
   * "PENDIENTE" | "ACEPTADA" | "RECHAZADA"
   */
  estado         String    @default("PENDIENTE")
  /**
   * Lo que conteste el administrador, sobre todo si dice que no
   */
  respuesta      String?
  createdAt      DateTime  @default(now())
  resueltaAt     DateTime?
  resueltaById   String?
  /**
   * La edición que se creó al aceptarla, para poder enlazarla
   */
  competitionId  String?

  user     User  @relation("SolicitanteDeLocke", fields: [userId], references: [id], onDelete: Cascade)
  resuelta User? @relation("ResolutorDeLocke", fields: [resueltaById], references: [id], onDelete: SetNull)

  @@index([estado, createdAt])
  @@index([userId])
}

/**
 * Lo que la gente le cuenta a quien lleva la aplicación desde el **Buzón**:
 * un error, una mejora o un cambio que haría. Es de la aplicación y no de un
 * locke, así que no cuelga de ninguna edición. Cada uno ve solo las suyas; el
 * Creador, todas. Las reglas (tipos, estados, límites) están en
 * `lib/buzon.ts`.
 */
model Sugerencia {
  id            String   @id @default(cuid())
  userId        String
  /**
   * "error" | "mejora" | "cambio"
   */
  tipo          String
  /**
   * La pantalla de la que habla (su dirección: "/equipo"), o null si es de la
   * aplicación en general
   */
  pantalla      String?
  /**
   * En una línea, para la lista
   */
  titulo        String
  texto         String
  /**
   * Una captura de pantalla, reducida en el navegador. Siempre `ref:` al
   * almacén de imágenes (ver `lib/almacen-de-imagenes.ts`)
   */
  imagen        String?
  /**
   * Navegador y tamaño de pantalla de quien la manda, que es lo primero que
   * hace falta para reproducir un error
   */
  dispositivo   String?
  /**
   * "NUEVA" | "LEIDA" | "APUNTADA" | "HECHA" | "DESCARTADA"
   */
  estado        String   @default("NUEVA")
  respuesta     String?
  /**
   * Si quien la mandó ya ha visto lo último que le contestaron: enciende su
   * punto de aviso en el menú hasta que entra en el Buzón
   */
  vistaPorAutor Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([estado, createdAt])
}

model GymClear {
  id            String   @id @default(cuid())
  participantId String
  levelCapId    String
  clearedAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  levelCap    LevelCap    @relation(fields: [levelCapId], references: [id], onDelete: Cascade)

  @@unique([participantId, levelCapId])
}

/**
 * El vídeo de cómo alguien se pasó un gimnasio. **Solo el enlace de YouTube**:
 * un combate son unos 115 MB y la base de datos gratis entera son 500 MB, así
 * que los vídeos viven fuera y aquí queda la dirección.
 * Va en su propia tabla y no dentro de `GymClear` a propósito: si colgara de
 * ahí, desmarcar la casilla de "superado" por un descuido se llevaría por
 * delante el enlace. Así el vídeo sobrevive a que alguien toque la casilla.
 */
model GymVideo {
  id            String   @id @default(cuid())
  participantId String
  levelCapId    String
  url           String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  levelCap    LevelCap    @relation(fields: [levelCapId], references: [id], onDelete: Cascade)

  // Uno por persona y gimnasio
  @@unique([participantId, levelCapId])
  @@index([levelCapId])
}

// ---------------------------------------------------------------------------
// Muertes
// ---------------------------------------------------------------------------

model Death {
  id            String    @id @default(cuid())
  participantId String
  // Especie del pokémon ("Typhlosion")
  species       String
  // Mote obligatorio en el locke
  nickname      String?
  level         Int?
  /**
   * Dónde murió, elegido de las zonas del mapa de la región. Es opcional
   * porque hay bajas que no pasan en ninguna zona —un combate de jornada, un
   * intercambio— y porque las de antes de esto no tienen ninguna puesta.
   */
  zoneId        String?
  /**
   * El sitio escrito a mano. Se sigue guardando para lo que no está en el mapa
   * y para no perder lo que ya había escrito antes de que hubiera zonas.
   */
  location      String?
  // Qué lo mató
  cause         String?
  diedAt        DateTime  @default(now())
  notes         String?
  // Sprite pequeño que se ve en la caja. Se elige al registrar la baja.
  boxImage      String?
  // Imagen grande del panel de detalle. Es independiente de la de la caja.
  detailImage   String?
  /**
   * Cuándo se revivió, si se revivió (un premio). La baja **se queda y sigue
   * contando** —para los desempates, el mapa y las cifras—: el premio es
   * recuperar al pokémon, no borrar lo que pasó. El pokémon vuelve a la caja y
   * su captura deja de apuntar aquí; en su historia queda qué baja era.
   */
  revividoEl    DateTime?
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // Si se borra la zona del mapa la baja se queda, sin sitio: perder el
  // cementerio por retocar un mapa sería absurdo.
  zone        MapZone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  // La captura del equipo y la caja que era, si se marcó desde allí (una sola)
  capturas    Capture[]

  @@index([participantId])
  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// Notas privadas (solo visibles para su autor)
// ---------------------------------------------------------------------------

/**
 * Un **wipeo**: que en un combate del juego te tumben el equipo entero.
 * Por las reglas de siempre un wipeo es perder el locke, pero eso es muy duro
 * si pasa en la primera ruta, así que aquí es **solo una marca que se cuenta**.
 * Se ponen las que haga falta y se quitan si se apuntó una por error. Que
 * alguien quede fuera del locke es otra cosa y se decide aparte, en
 * `Participant.motivoDeSalida`.
 */
model Wipeo {
  id            String   @id @default(cuid())
  participantId String
  /**
   * Cuándo pasó. Por defecto hoy, y se puede corregir.
   */
  ocurridoAt    DateTime @default(now())
  /**
   * Contra qué o quién: "Bruno", "la Ruta 34", "un Onix con Rugido".
   */
  contra        String?
  notas         String?
  /**
   * Quién lo apuntó: el propio jugador o quien administre el locke
   */
  autorId       String?
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, ocurridoAt])
}

model Note {
  id            String   @id @default(cuid())
  competitionId String
  authorId      String
  // Sub-apartado: sobre qué jugador va la nota. null = notas generales.
  subjectId     String?
  title         String
  body          String   @default("")
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject     Participant? @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([competitionId, authorId])
}

/**
 * El equipo de seis que alguien está probando en la calculadora de tipos.
 * Vive en la pantalla de las notas y es **igual de privado**: se consulta y se
 * guarda siempre por su participante, no hay ninguna pantalla que enseñe el de
 * otro y los administradores tampoco lo ven. Uno por persona y edición: es un
 * borrador de trabajo, no una colección.
 */
model TypeTeam {
  id            String   @id @default(cuid())
  participantId String   @unique
  /**
   * Los huecos, en JSON: `[{"id":6,"nombre":"Charizard"}, …]`. Puede haber
   * menos de seis. El `id` es el de la forma en la pokédex, que es con lo que
   * se buscan sus tipos.
   */
  members       String   @default("[]")
  /**
   * Con qué tabla se cuenta: `"juego"` la de la generación del locke, `"ahora"`
   * la de hoy, con tipo Hada. Muchos grupos juegan los combates en simuladores
   * modernos aunque el locke sea de Johto, así que la elección es de cada uno.
   */
  tabla         String   @default("juego")
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Puntos
// ---------------------------------------------------------------------------

// Historial de movimientos de puntos. El total de un participante es
// competition.startingPoints + suma de todos sus deltas.
model PointEntry {
  id             String   @id @default(cuid())
  competitionId  String
  participantId  String
  delta          Int
  reason         String
  createdById    String?
  createdAt      DateTime @default(now())
  // Si el punto viene de ganar un combate de jornada, se enlaza con él para
  // poder rehacerlo si se corrige el resultado.
  sourceMatchId  String?  @unique
  /**
   * Y si viene de ganar un Battle Royale, con el royale. Es otro campo y no el
   * de arriba porque son tablas distintas; la idea es la misma: si se corrige
   * el orden de llegada, el punto se recoloca en vez de duplicarse.
   * **Sin `@unique` a propósito**: añadir una restricción de unicidad hace que
   * `prisma db push` avise de posible pérdida de datos, y el despliegue de
   * Vercel corre ese comando sin aceptar avisos, así que el despliegue se
   * caería. Que no haya dos puntos por el mismo royale lo garantiza el código:
   * al guardar el orden se borra lo que hubiera y se vuelve a crear.
   */
  sourceRoyaleId String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("PointAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([competitionId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Jornadas y combates
// ---------------------------------------------------------------------------

model Matchday {
  id            String    @id @default(cuid())
  competitionId String
  label         String
  // Hito al que corresponde ("2da medalla", "Endgame")
  milestone     String?
  position      Int       @default(0)
  playedAt      DateTime?
  // Puntos que se llevan los ganadores de esta jornada
  pointsForWin  Int       @default(1)
  /**
   * Qué tipo de combate se juega ("singles", "dobles", "vgc", "royale"…). Ver
   * lib/formatos-de-combate.ts, que es donde viven las fichas: aquí solo se
   * guarda cuál es.
   */
  formato       String    @default("singles")
  /**
   * Lo que el formato no dice: "monotipo agua", "sin objetos", "nivel 50".
   * Texto libre a propósito: las variaciones se inventan sobre la marcha y no
   * hay lista que las cubra.
   */
  condiciones   String?
  /**
   * En un dualocke, si la jornada es **un combate** (1) o **una serie al mejor
   * de tres** (3), como las llaves de la final: el mismo equipo para toda la
   * serie. Se cambia mientras no se haya escrito nada en la jornada. Vacío es
   * «lo de siempre de su locke» (ver `alMejorDeDeLaJornada`): así las jornadas
   * de antes siguen siendo al mejor de tres sin tocarlas.
   */
  alMejorDe     Int?

  /**
   * Por qué el MVP es el MVP. Lo escribe un administrador; el pokémon en sí no
   * se guarda aquí, sale de la votación.
   */
  mvpReason     String?
  /**
   * Solo se usa cuando la votación acaba empatada arriba: el administrador
   * elige entre los empatados y ese desempate manda. Si luego los votos
   * deshacen el empate, se ignora.
   */
  mvpTiebreakId String?
  /**
   * Cuándo se creó. No se enseña en ninguna parte: sirve para el punto de
   * "jornada nueva" del menú, que compara con la última visita de cada uno.
   */
  createdAt     DateTime @default(now())

  competition Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches     Match[]
  royales     Royale[]
  mvpVotes    MvpVote[]
  mvpTiebreak MatchPokemon? @relation("MatchdayTiebreak", fields: [mvpTiebreakId], references: [id], onDelete: SetNull)

  @@index([competitionId, position])
}

model Match {
  id             String    @id @default(cuid())
  matchdayId     String
  participantAId String
  participantBId String
  winnerId       String?
  // Diferencia de pokémon del combate (desempate de la clasificación)
  pokemonDiff    Int?
  /**
   * Enlace a la repetición del combate (Showdown, un vídeo…). Lo pega un
   * administrador; si no hay, no sale el botón de verlo.
   */
  replayUrl      String?
  playedAt       DateTime?
  notes          String?
  position       Int       @default(0)
  /**
   * El combate no se jugó: se ganó porque el otro se retiró del locke. Se
   * guarda para poder enseñarlo distinto, que no parezca una victoria normal.
   */
  porRetirada    Boolean   @default(false)
  /**
   * Solo si **este** combate se juega distinto al resto de su jornada. Vacío
   * significa "el de la jornada", que es lo normal.
   */
  formato        String?
  /**
   * Alguien que está fuera del locke lo juega igual, porque la organización
   * lo ha permitido. Es la excepción a la norma: se pone sola al montar a
   * mano un combate con alguien retirado o con el locke perdido.
   * **Sin esto el combate se daría por ganado al rival.** `lib/retiradas.ts`
   * reparte los combates pendientes de los que están fuera, y este hay que
   * dejarlo en paz para que lo jueguen.
   */
  excepcion      Boolean   @default(false)
  /**
   * Lo que hizo cada pokémon en el combate, leído de la repetición
   * (`estadisticasDeLaRepeticion` en lib/showdown.ts): KOs, críticos,
   * supereficaces, daño… Se lee una vez y se guarda; `estadisticasDe` es el
   * enlace del que salió, para volver a leerlo si se cambia. Ver
   * lib/estadisticas.ts.
   */
  estadisticas   Json?
  estadisticasDe String?

  matchday     Matchday       @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  participantA Participant    @relation("MatchPlayerA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB Participant    @relation("MatchPlayerB", fields: [participantBId], references: [id], onDelete: Cascade)
  winner       Participant?   @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  team         MatchPokemon[]

  @@index([matchdayId])
}

/**
 * Un pokémon del equipo que un jugador sacó en un combate concreto. Los pone el
 * administrador y son los candidatos a MVP de esa jornada.
 */
model MatchPokemon {
  id               String   @id @default(cuid())
  /**
   * Qué pokémon de la caja de su entrenador es, cuando no se puede saber por
   * el mote y la especie (dos Pidgey sin mote): lo elige su dueño al mirar sus
   * números del combate. Así sus estadísticas se juntan con las del bueno.
   * Ver lib/estadisticas.ts.
   */
  captureId        String?
  capture          Capture? @relation("EnCombates", fields: [captureId], references: [id], onDelete: SetNull)
  /**
   * De qué combate es el equipo. Va uno de los dos, nunca los dos: los de
   * jornada apuntan a `matchId` y los de reto a `challengeMatchId`. Se comparte
   * la tabla para poder reutilizar el mismo editor de equipos.
   */
  matchId          String?
  challengeMatchId String?
  /**
   * El equipo con el que alguien se pasó un **gimnasio**, en los lockes en
   * solitario. Es el tercer sitio del que puede colgar un equipo, y va aquí por
   * lo mismo que los retos: es el mismo dato, así que comparte el editor, la
   * descarga de sprites y las direcciones de imagen.
   * Cuelga del level cap y no de `GymClear`, que es la marca de "superado", por
   * el mismo motivo por el que el vídeo del gimnasio tiene su propia tabla:
   * desmarcar la casilla por un descuido se llevaría el equipo por delante.
   */
  levelCapId       String?
  /**
   * El cuarto sitio del que cuelga un equipo: un Battle Royale, donde no hay
   * dos bandos sino cuatro jugadores en el mismo combate.
   */
  royaleId         String?
  /**
   * Y el quinto: **el equipo con el que alguien juega la final**. Es uno solo
   * para todo el cuadro —no uno por llave ni por combate—, porque en la Final
   * Four cada uno se presenta con un equipo y con ese juega hasta que cae. Por
   * eso cuelga del `FinalFour` y se distingue por `participantId`.
   */
  finalFourId      String?
  participantId    String
  species          String
  nickname         String?
  /**
   * Sprite de caja de Pokémon HOME: es el que se ve en la lista del combate.
   */
  boxImage         String?
  /**
   * Ilustración oficial. Solo se usa en la ficha si gana la votación de MVP.
   */
  detailImage      String?
  position         Int      @default(0)

  match          Match?          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  challengeMatch ChallengeMatch? @relation(fields: [challengeMatchId], references: [id], onDelete: Cascade)
  levelCap       LevelCap?       @relation(fields: [levelCapId], references: [id], onDelete: Cascade)
  royale         Royale?         @relation(fields: [royaleId], references: [id], onDelete: Cascade)
  finalFour      FinalFour?      @relation(fields: [finalFourId], references: [id], onDelete: Cascade)
  participant    Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  votes          MvpVote[]
  tiebreakOf     Matchday[]      @relation("MatchdayTiebreak")

  @@index([matchId])
  @@index([challengeMatchId])
  @@index([levelCapId, participantId])
  @@index([royaleId, participantId])
  @@index([finalFourId, participantId])
  @@index([participantId])
  @@index([captureId])
}

/**
 * Combate de reto: un pique suelto entre dos jugadores, fuera de las jornadas.
 * Lleva premio y castigo, cuenta para el historial de victorias y derrotas,
 * pero **no da puntos**. Su diferencia de pokémon solo entra en el desempate de
 * la clasificación si la competición lo tiene activado.
 */
model ChallengeMatch {
  id             String    @id @default(cuid())
  competitionId  String
  participantAId String
  participantBId String
  winnerId       String?
  pokemonDiff    Int?
  /**
   * Enlace a la repetición del combate, igual que en las jornadas.
   */
  replayUrl      String?
  /**
   * Qué se lleva el ganador, escrito a mano ("eliges su starter")
   */
  prize          String?
  /**
   * Qué se traga el perdedor
   */
  punishment     String?
  /**
   * Si el castigo se anuncia al resto del grupo.
   * Un castigo es información para todos —de eso va el pique—, así que sale en
   * la portada hasta que un administrador lo quite. Empieza puesto y se apaga a
   * mano, no al revés: si hubiera que acordarse de encenderlo, no se encendería
   * nunca.
   */
  castigoVisible Boolean   @default(true)
  playedAt       DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  /**
   * Qué tipo de combate es. Cada reto lleva el suyo, sin depender de nada
   */
  formato        String    @default("singles")
  /**
   * Lo que hizo cada pokémon, leído de la repetición, como en `Match`.
   */
  estadisticas   Json?
  estadisticasDe String?

  competition  Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participantA Participant      @relation("ChallengePlayerA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB Participant      @relation("ChallengePlayerB", fields: [participantBId], references: [id], onDelete: Cascade)
  winner       Participant?     @relation("ChallengeWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  team         MatchPokemon[]
  premios      ChallengePrize[]

  @@index([competitionId])
}

/**
 * Un objeto de la bolsa que se lleva quien gane un reto.
 * Convive con `ChallengeMatch.prize`, que es texto libre: hay premios que no
 * son un objeto ("eliges su starter") y esos se siguen escribiendo a mano. Lo
 * de aquí, en cambio, **cae solo en la bolsa del ganador** al apuntar quién
 * ganó.
 * `entregadoA` guarda a quién se le dio ya, fila por fila. Es lo que permite
 * corregir un resultado sin liarla: si cambia el ganador se le quita al primero
 * y se le da al segundo, y si se añade un objeto después de haber apuntado el
 * resultado, ese objeto se entrega y los demás se quedan como están.
 */
model ChallengePrize {
  id               String  @id @default(cuid())
  challengeMatchId String
  itemId           String
  quantity         Int     @default(1)
  entregadoA       String?

  challenge ChallengeMatch @relation(fields: [challengeMatchId], references: [id], onDelete: Cascade)
  item      Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([challengeMatchId, itemId])
}

/**
 * Voto de un jugador al MVP de una jornada. Uno por jugador y jornada: volver a
 * votar cambia el voto anterior en vez de sumar otro.
 */
model MvpVote {
  id             String   @id @default(cuid())
  matchdayId     String
  voterId        String
  matchPokemonId String
  createdAt      DateTime @default(now())

  matchday Matchday     @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  voter    Participant  @relation("MvpVoter", fields: [voterId], references: [id], onDelete: Cascade)
  pokemon  MatchPokemon @relation(fields: [matchPokemonId], references: [id], onDelete: Cascade)

  @@unique([matchdayId, voterId])
  @@index([matchPokemonId])
}

// ---------------------------------------------------------------------------
// Sorteo de pokémon de préstamo
// ---------------------------------------------------------------------------

/**
 * Un **bote de pokémon que se reparte al azar** entre unas cuantas personas.
 * Es lo que hace falta para jugar una jornada de "Pokémon de Préstamo": entre
 * todos se echan bichos al bote y la aplicación reparte, sin que nadie tenga
 * que hacer papelitos. Vive por su cuenta y no cuelga de una jornada: se puede
 * sortear para lo que sea, y lo que salga se usa donde se quiera.
 */
model Sorteo {
  id            String    @id @default(cuid())
  competitionId String
  label         String?
  /**
   * Cuándo se repartió. Vacío mientras el bote se está llenando
   */
  repartidoAt   DateTime?
  createdAt     DateTime  @default(now())

  competition   Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  pokemon       SorteoPokemon[]
  participantes SorteoParticipante[]

  @@index([competitionId, createdAt])
}

/**
 * Quién entra en el reparto. De dos a seis, que es lo que cabe en un equipo.
 */
model SorteoParticipante {
  id            String @id @default(cuid())
  sorteoId      String
  participantId String

  sorteo      Sorteo      @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sorteoId, participantId])
  @@index([participantId])
}

/**
 * Un pokémon del bote.
 * `tocaAId` vacío significa una de dos cosas según el momento: que todavía no
 * se ha repartido, o que **se quedó fuera** porque había más pokémon que
 * huecos. Un equipo son seis como mucho, así que con seis personas entran 36 y
 * lo que sobre se queda en el bote para otra vez.
 */
model SorteoPokemon {
  id          String   @id @default(cuid())
  sorteoId    String
  species     String
  nickname    String?
  /**
   * Sprite de caja, descargado al guardar como en el resto de la aplicación
   */
  boxImage    String?
  /**
   * Quién lo echó al bote
   */
  aportadoPor String?
  /**
   * A quién le ha tocado
   */
  tocaAId     String?
  /**
   * Su sitio dentro del equipo de quien le tocó
   */
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  sorteo   Sorteo       @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  aportado Participant? @relation("SorteoAportadoPor", fields: [aportadoPor], references: [id], onDelete: SetNull)
  tocaA    Participant? @relation("SorteoTocaA", fields: [tocaAId], references: [id], onDelete: SetNull)

  @@index([sorteoId])
  @@index([tocaAId])
}

// ---------------------------------------------------------------------------
// Battle Royale
// ---------------------------------------------------------------------------

/**
 * Un **Battle Royale**: un combate con más de dos jugadores dentro de una
 * jornada.
 * Tiene su propia tabla y no cabe en `Match` a propósito. Un combate normal es
 * "A contra B, gana uno y le quedan tantos pokémon vivos"; un royale es
 * "entran cuatro y salen en este orden". Meterlo a la fuerza en la tabla de
 * siempre habría obligado a llenar de excepciones la clasificación, el cara a
 * cara y el emparejador, y a cambio no habría contado bien ninguna de las dos
 * cosas.
 * Lo que sí comparte con los combates de siempre es el **equipo**: los pokémon
 * que saca cada uno se apuntan con el mismo editor (`MatchPokemon.royaleId`).
 */
model Royale {
  id         String    @id @default(cuid())
  matchdayId String
  /**
   * Cómo se llama este, cuando la jornada tiene más de uno ("Ronda 1")
   */
  label      String?
  /**
   * La crónica: qué pasó, contado por quien quiera dejarlo escrito. Es pública
   * y es media gracia de un royale —lo que se cuenta después—, así que tiene
   * sitio propio en vez de acabar en las notas privadas de alguien.
   */
  cronica    String?
  replayUrl  String?
  playedAt   DateTime?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  matchday Matchday       @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  puestos  RoyalePuesto[]
  equipos  MatchPokemon[]

  @@index([matchdayId, position])
}

/**
 * Quién jugó un royale y en qué puesto quedó.
 * `puesto` vacío significa "todavía no se sabe": un royale se prepara con sus
 * jugadores y el orden se rellena al terminar. Los puntos se los lleva el
 * primero, igual que el ganador de un combate normal.
 */
model RoyalePuesto {
  id            String  @id @default(cuid())
  royaleId      String
  participantId String
  /**
   * 1 es el que gana. Vacío mientras no se haya jugado
   */
  puesto        Int?
  /**
   * Cuántos pokémon le quedaban vivos, si se quiere apuntar
   */
  vivos         Int?
  notes         String?

  royale      Royale      @relation(fields: [royaleId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([royaleId, participantId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Final Four y hall de la fama
// ---------------------------------------------------------------------------

/**
 * El cuadro final. Se genera cuando ya están jugadas todas las jornadas, y
 * guarda la clasificación de ese momento congelada (`seeds`): así, si después
 * se corrige algún punto, el cuadro no se recoloca a mitad del torneo.
 */
model FinalFour {
  id            String   @id @default(cuid())
  competitionId String   @unique
  /**
   * Los clasificados en orden, del 1º al último, tantos como diga el formato
   */
  seeds         String[]
  /**
   * Con cuántos jugadores se sembró, que es lo que decide el formato del
   * cuadro (ver `lib/formatos-finales.ts`).
   * Se guarda en vez de mirar cuántos hay ahora **a propósito**: si alguien se
   * retira con la final ya empezada, el cuadro no puede cambiar de forma a
   * mitad y dejar los combates jugados sin sentido. Los seis de las ediciones
   * de antes de que existieran los formatos se quedan con su 6.
   */
  jugadores     Int      @default(6)
  createdAt     DateTime @default(now())

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches     FinalMatch[]
  // El equipo con el que cada uno juega el cuadro: uno por participante
  equipos     MatchPokemon[]
}

/**
 * Un combate del cuadro. Los emparejamientos no se guardan: se deducen de
 * `seeds` y de quién va ganando, así que no pueden quedar incoherentes.
 * key: CROSS_A (3º-6º), CROSS_B (4º-5º), SEMI_A (1º-ganador A),
 * SEMI_B (2º-ganador B) y FINAL.
 */
model FinalMatch {
  id             String    @id @default(cuid())
  finalFourId    String
  /**
   * Qué combate es, en `LLAVE#n`: "SEMI_A#2" es el segundo de esa llave.
   * Todas las llaves del cuadro se juegan al mejor de tres, así que cada una
   * tiene sus tres filas desde que se siembra (ver `lib/formatos-finales.ts`).
   */
  key            String
  winnerId       String?
  pokemonDiff    Int?
  playedAt       DateTime?
  notes          String?
  /**
   * Enlace a la repetición, igual que en los combates de jornada
   */
  replayUrl      String?
  /**
   * Lo que hizo cada pokémon, leído de la repetición, como en `Match`.
   */
  estadisticas   Json?
  estadisticasDe String?

  finalFour FinalFour    @relation(fields: [finalFourId], references: [id], onDelete: Cascade)
  winner    Participant? @relation("FinalMatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([finalFourId, key])
}

/**
 * Un pokémon del equipo con el que cada jugador termina el locke.
 */
model HallOfFameEntry {
  id            String   @id @default(cuid())
  participantId String
  species       String
  nickname      String?
  // Sprite pequeño, el de la casilla del equipo
  image         String?
  /**
   * Ilustración grande, para verlo en grande al tocarlo. Los equipos
   * apuntados antes de que existiera no la tienen, así que la ficha se
   * apaña con el sprite pequeño agrandado.
   */
  detailImage   String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

/**
 * Los pokémon favoritos de un jugador en esta edición: los que le han hecho el
 * locke, estén vivos o muertos. Van en el participante y no en el usuario para
 * que cada edición conserve los suyos al archivarse, igual que el as.
 */
model FavoritePokemon {
  id            String   @id @default(cuid())
  participantId String
  species       String
  nickname      String?
  image         String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Ruleta personalizable
// ---------------------------------------------------------------------------

model Roulette {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  description   String?
  // Si es false, las opciones ya salidas se desactivan automáticamente
  allowRepeats  Boolean  @default(true)
  spinSeconds   Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  options     RouletteOption[]
  spins       RouletteSpin[]
  tickets     RouletteTicket[]
  // Opciones y giros de otras ruletas que reparten tickets de esta
  daTickets   RouletteOption[] @relation("PremioDeTickets")
  dioTickets  RouletteSpin[]   @relation("GiroDaTickets")

  @@index([competitionId])
}

/**
 * Una casilla de la ruleta. Puede ser texto suelto —lo de siempre— o **un
 * premio de verdad**: un objeto del catálogo de la bolsa, o tickets de una
 * ruleta. Los tres son excluyentes; `label` es lo que se pinta en la rueda y en
 * los premios se rellena solo con el nombre del objeto o "2 × Castigos".
 */
model RouletteOption {
  id          String  @id @default(cuid())
  rouletteId  String
  label       String
  // Peso relativo: una opción con peso 3 sale el triple que una de peso 1
  weight      Int     @default(1)
  color       String?
  enabled     Boolean @default(true)
  position    Int     @default(0)
  /**
   * Si la opción es un objeto del catálogo, cae solo en la bolsa al salir
   */
  itemId      String?
  /**
   * De qué ruleta son los tickets que reparte, si reparte tickets
   */
  ticketsDeId String?
  /**
   * Cuántos: unidades del objeto o tickets. Sin premio no pinta nada.
   */
  cantidad    Int     @default(1)

  roulette  Roulette       @relation(fields: [rouletteId], references: [id], onDelete: Cascade)
  spins     RouletteSpin[]
  item      Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull)
  ticketsDe Roulette?      @relation("PremioDeTickets", fields: [ticketsDeId], references: [id], onDelete: SetNull)

  @@index([rouletteId, position])
}

/**
 * Tickets de ruleta. Como los puntos, es un historial y no un contador: cada
 * fila suma (los que concede un administrador) o resta (el que se gasta al
 * girar), y el saldo es la suma. Así se ve quién dio qué y por qué.
 */
model RouletteTicket {
  id            String   @id @default(cuid())
  competitionId String
  participantId String
  delta         Int
  reason        String?
  /**
   * De qué ruleta es el ticket: valen solo para la suya. En la base de datos
   * es opcional para no romper las filas de la primera versión, en la que los
   * tickets servían para cualquiera; el código lo exige siempre y esas filas
   * antiguas no cuentan para ninguna ruleta.
   */
  rouletteId    String?
  createdById   String?
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  roulette    Roulette?   @relation(fields: [rouletteId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("TicketAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([competitionId])
  @@index([participantId])
}

model RouletteSpin {
  id                String   @id @default(cuid())
  rouletteId        String
  optionId          String?
  // Copia del texto por si luego se borra o renombra la opción
  optionLabel       String
  spunById          String?
  note              String?
  createdAt         DateTime @default(now())
  /**
   * El premio que tocó, **copiado** de la opción por lo mismo que el texto: la
   * opción se puede borrar y el historial tiene que seguir sabiendo qué se dio
   * y a quién. `entregadoA` es el participante que se lo llevó; en null con
   * premio significa **pendiente de entregar**, que es lo que pasa cuando gira
   * quien administra y no está gastando ticket de nadie.
   */
  premioItemId      String?
  premioTicketsDeId String?
  premioCantidad    Int      @default(0)
  entregadoA        String?

  roulette      Roulette        @relation(fields: [rouletteId], references: [id], onDelete: Cascade)
  option        RouletteOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  spunBy        User?           @relation(fields: [spunById], references: [id], onDelete: SetNull)
  premioItem    Item?           @relation(fields: [premioItemId], references: [id], onDelete: SetNull)
  premioTickets Roulette?       @relation("GiroDaTickets", fields: [premioTicketsDeId], references: [id], onDelete: SetNull)
  entregado     Participant?    @relation("PremioDeRuleta", fields: [entregadoA], references: [id], onDelete: SetNull)

  @@index([rouletteId])
}

/**
 * Una copia de seguridad completa: todas las tablas menos esta, en JSON,
 * comprimido y guardado como texto.
 * **No tiene ninguna relación con el resto del modelo, y es a propósito.** Al
 * restaurar se vacían todas las tablas; si esta colgara de `User`, el vaciado
 * se llevaría por delante las copias justo cuando hacen falta. Por eso el autor
 * se guarda como nombre suelto y no como enlace.
 */
/**
 * Los apuntes que ya se han subido desde la cola de un móvil sin conexión.
 * Solo guarda el identificador que generó el propio móvil: si el mismo apunte
 * llega dos veces —porque se reintentó, porque se abrió la aplicación en dos
 * sitios— la segunda se descarta en vez de duplicar la captura. No guarda el
 * contenido: eso ya está en su tabla de siempre.
 */
/**
 * El almacén de imágenes: **cada una guardada una sola vez**.
 * Antes, el sprite de Garchomp se guardaba entero en cada combate, en cada baja
 * y en cada bote: la misma imagen de 18 KB repetida decenas de veces. Aquí se
 * guarda una vez y las filas apuntan a ella con `ref:<clave>` en la columna de
 * siempre, que son 20 caracteres en vez de 18 KB.
 * La **clave dice de dónde salió**, y por eso no hay que descargar nada que ya
 * se tenga:
 * - `pkm-6-box`, `pkm-6-detail-shiny`… el sprite de una especie. Nunca cambian.
 * - `obj-poke-ball` el dibujo de un objeto.
 * - `h-<md5>` una imagen cualquiera, guardada por su contenido. Es la que sale
 * al deduplicar lo que ya estaba escrito.
 * Como la clave manda en el contenido y el contenido no cambia nunca, la
 * dirección `/api/imagen/c/<clave>` se puede cachear para siempre **y la
 * comparten todas las filas**: el navegador se baja un Garchomp, no doce.
 */
model Imagen {
  clave     String   @id
  /**
   * La imagen como data URL, igual que se guardaba antes en cada fila
   */
  datos     String
  /**
   * Lo que ocupa, para poder enseñarlo sin leer la imagen entera
   */
  bytes     Int
  createdAt DateTime @default(now())
}

model ApunteSincronizado {
  /**
   * El identificador que puso el móvil, no uno nuestro
   */
  id        String   @id
  userId    String
  /**
   * "captura" | "baja" | "gimnasio" | "nota"
   */
  tipo      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Backup {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /**
   * "auto" (la del día), "manual" (a mano) o "previa" (antes de restaurar)
   */
  kind       String   @default("auto")
  /**
   * Quién la pidió, por su nombre. Suelto: ver el comentario de arriba.
   */
  authorName String?
  /**
   * Cuántas filas de cada tabla, para enseñarlo sin abrir el fichero
   */
  summary    String
  /**
   * Lo que ocupa el JSON sin comprimir, en bytes
   */
  rawSize    Int
  /**
   * El volcado entero: JSON comprimido con gzip y pasado a base64
   */
  payload    String
  /**
   * Cómo está guardado el volcado. **1**: lo lleva todo dentro, imágenes
   * incluidas, que es como se guardaban antes del almacén. **2**: las imágenes
   * se sacan del almacén al leerla.
   * Es una columna y no se deduce de `imagenes` porque una copia puede
   * necesitar cero imágenes —una base de datos recién puesta— y entonces
   * parecería para siempre una copia por aligerar, con un aviso que no se iría
   * nunca y un botón que no haría nada.
   */
  formato    Int      @default(1)
  /**
   * Las claves del almacén que necesita esta copia (formato 2).
   * La copia **no guarda las imágenes**: ya están en `Imagen`, y guardarlas
   * otra vez en cada una de las cinco copias multiplicaba por cinco lo que más
   * pesa. Aquí queda apuntado cuáles hacen falta, para que la limpieza de
   * huérfanas no tire una imagen que una copia todavía necesita.
   */
  imagenes   String[]

  @@index([createdAt])
}

/**
 * Un locke que se jugó **antes de que existiera la aplicación**, apuntado a
 * mano para que no se pierda del palmarés.
 * No es una `Competition`: no tiene jornadas, ni bajas, ni combates, porque de
 * aquello no quedó nada guardado. Es solo la línea del palmarés —quién ganó, a
 * quién y cuándo—, y por eso vive en su propia tabla en vez de ensuciar
 * `Competition` con ediciones vacías que el resto de pantallas tendría que
 * aprender a esquivar.
 * **Quién lo ve sale de `jugadoresIds`**: solo la gente que lo jugó. Si fuera
 * visible para todos, alguien que monta su propio locke vería el histórico de
 * un grupo con el que no tiene nada que ver.
 */
model LockeDeAntes {
  id               String   @id @default(cuid())
  nombre           String
  /**
   * El juego, escrito a mano: de entonces no hay identificador que valga
   */
  juego            String?
  cuando           DateTime
  /**
   * El ganador, si tiene cuenta. Si no la tiene, va su nombre escrito en
   * `ganadorNombre` y esto queda vacío: de un locke de antes puede haber gente
   * que nunca se hizo cuenta.
   */
  ganadorId        String?
  ganadorNombre    String?
  subcampeonId     String?
  subcampeonNombre String?
  /**
   * Las cuentas de quienes lo jugaron. El ganador entra siempre.
   */
  jugadoresIds     String[] @default([])
  /**
   * Los que lo jugaron **sin cuenta**, por su nombre. Salen en la línea del
   * locke y cuentan para su tamaño, pero no tienen fila en ningún palmarés.
   * Si uno se hace cuenta luego, al editar se vincula y pasa a `jugadoresIds`.
   */
  sinCuenta        String[] @default([])
  /**
   * El logo de aquel locke, como el de una edición (data URL o `ref:` del almacén)
   */
  logo             String?
  notas            String?
  createdById      String?
  createdAt        DateTime @default(now())

  ganador     User? @relation("GanadorDeAntes", fields: [ganadorId], references: [id], onDelete: Cascade)
  subcampeon  User? @relation("SubcampeonDeAntes", fields: [subcampeonId], references: [id], onDelete: SetNull)
  apuntadoPor User? @relation("ApuntadorDeAntes", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ganadorId])
}

// ---------------------------------------------------------------------------
// Registro de errores
// ---------------------------------------------------------------------------

/**
 * Un intento de entrar **que falló**, para frenar a quien prueba contraseñas
 * sin parar (ver `lib/intentos-de-entrada.ts`). Se apunta el usuario que se
 * escribió —exista o no— y la red desde la que se intentó, esta **resumida**
 * (un hash con el secreto de la aplicación): sirve para contar intentos, no
 * para saber desde dónde entra nadie. Es de paso: se borra al entrar bien y lo
 * de más de un día se tira solo.
 */
model IntentoDeEntrada {
  id        String   @id @default(cuid())
  usuario   String
  red       String
  createdAt DateTime @default(now())

  @@index([usuario, createdAt])
  @@index([red, createdAt])
  @@index([createdAt])
}

/**
 * Un fallo de la aplicación, del navegador de alguien o del servidor, para
 * verlo en Diagnóstico **sin que nadie tenga que avisar**. Se guarda quién,
 * dónde y qué; los iguales se agrupan por `huella` al enseñarlos. Es un
 * registro de paso: se queda en los últimos 30 días y como mucho 500 filas.
 * El nombre va copiado y no enlazado a la cuenta: si se borra la cuenta, el
 * fallo sigue sirviendo.
 */
model ErrorDeApp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // "navegador" o "servidor"
  origen    String
  mensaje   String
  // La pila del fallo, recortada
  detalle   String?
  // El código que enseña la pantalla de error ("Código del fallo"), si lo hay
  codigo    String?
  ruta      String?
  userId    String?
  quien     String?
  navegador String?
  huella    String

  @@index([createdAt])
  @@index([huella])
}

/**
 * Una jornada borrada, **entera** —combates, equipos, royales, votos del MVP y
 * los puntos que dio— para poder devolverla durante unos días (ver
 * lib/papelera.ts). Borrar una jornada no tenía vuelta atrás y se llevaba
 * resultados y equipos de golpe.
 */
model JornadaBorrada {
  id            String   @id @default(cuid())
  competitionId String
  label         String
  // Todo lo que se llevó, tal cual, para volver a crearlo con los mismos ids
  datos         Json
  borradaAt     DateTime @default(now())
  quien         String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, borradaAt])
}

/**
 * El **registro de cambios** de cada locke: quién cambió un resultado, borró
 * una jornada, tocó los puntos, una regla o la bolsa de alguien, y cuándo. Lo
 * apunta `registrar()` (lib/registro.ts) desde las acciones de quien
 * administra y se ve en Diagnóstico.
 * Sin relación con `Competition` ni con `User` a propósito: el registro tiene
 * que aguantar que se borre el locke o la cuenta, que es justo cuando hace
 * falta saber quién fue. Por eso lleva copiados los nombres.
 */
model CambioDelLocke {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  competitionId String?
  // El nombre del locke cuando se hizo el cambio
  locke         String?
  userId        String?
  quien         String?
  // De qué va, para filtrar: "jornadas", "puntos", "reglas", "bolsa"…
  zona          String
  texto         String

  @@index([createdAt])
  @@index([competitionId, createdAt])
}
