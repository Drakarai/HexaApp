// HexaApp — gestor de competiciones tipo "Hexalocke"
// SQLite no soporta enums en Prisma, por eso los campos de tipo enumerado son String
// y los valores válidos están centralizados en src/lib/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // La que usa la aplicación para atender páginas. Con el pooler de Neon, es
  // la que lleva "-pooler" en el nombre del servidor.
  url       = env("DATABASE_URL")
  // La directa, solo para crear tablas al publicar: eso no funciona a través
  // del pooler. Si no se configura, scripts/preparar-build.mjs la iguala a la
  // de arriba, que es lo correcto cuando no hay pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y sesiones
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  // "ADMIN" | "PLAYER". Los admin globales pueden crear competiciones y usuarios.
  role         String   @default("PLAYER")
  avatarColor  String   @default("#6366f1")
  // Foto de perfil: URL externa o imagen subida (data URL ya redimensionada)
  avatarImage  String?
  // Tema de color elegido, uno por juego principal. Ver src/lib/themes.ts
  theme        String   @default("hexa")
  createdAt    DateTime @default(now())

  participations Participant[]
  notes          Note[]
  pointsGiven    PointEntry[]  @relation("PointAuthor")
  spins          RouletteSpin[]
  competitions   Competition[] @relation("CompetitionCreator")
  ticketsGiven   RouletteTicket[] @relation("TicketAuthor")
  titles         TitleAward[]  @relation("TitleOwner")
  titlesGiven    TitleAward[]  @relation("TitleGiver")
}

// ---------------------------------------------------------------------------
// Títulos
// ---------------------------------------------------------------------------

/**
 * Un título que un administrador se inventa y reparte: "Rey del cementerio",
 * "El que nunca falla". **Es puramente estético**, no da puntos ni ventajas.
 * Van en el usuario y no en el participante para que sigan a la persona de una
 * edición a otra.
 */
model Title {
  id          String   @id @default(cuid())
  name        String
  /** Qué significa. Sale al pasar por encima de la chapa. */
  description String?
  /** Un emoji, para que la chapa se reconozca de un vistazo */
  icon        String?
  color       String   @default("#a78bfa")
  createdAt   DateTime @default(now())

  awards TitleAward[]
}

/** Que a alguien le hayan dado un título, con el porqué. */
model TitleAward {
  id        String   @id @default(cuid())
  titleId   String
  userId    String
  /** Por qué se lo ha llevado. Lo escribe quien lo concede. */
  note      String?
  /**
   * Si es el que lleva puesto ahora mismo, el que sale debajo de su nombre.
   * Solo puede haber uno encendido por persona; de eso se encarga la acción de
   * equipar, que apaga los demás en la misma transacción. Se guarda aquí y no
   * en `User` para no meter una clave foránea circular entre las dos tablas.
   */
  equipped  Boolean  @default(false)
  awardedAt DateTime @default(now())
  awardedById String?

  title     Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  user      User  @relation("TitleOwner", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy User? @relation("TitleGiver", fields: [awardedById], references: [id], onDelete: SetNull)

  // El mismo título dos veces a la misma persona no aporta nada
  @@unique([titleId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Bolsa
// ---------------------------------------------------------------------------

/**
 * Un objeto que puede acabar en la bolsa de alguien. Hay de dos clases y se
 * guardan igual:
 *
 * - Los del juego, elegidos de la lista de PokéAPI: llegan con su `apiSlug` y
 *   el servidor se baja el dibujo al crearlos, así que después la aplicación no
 *   depende de que GitHub siga en pie.
 * - Los inventados ("Captura extra", "Objeto competitivo"), con la imagen que
 *   suba el administrador.
 *
 * El catálogo es **global y no de cada edición**, como los títulos: "Captura
 * extra" significa lo mismo en el Hexalocke 3 que en el 2 y no tiene sentido
 * volver a crearlo cada vez. Las bolsas sí son de cada participante.
 */
model Item {
  id          String   @id @default(cuid())
  name        String
  /** Para qué sirve. Sale debajo del nombre en la bolsa. */
  description String?
  /** El objeto en PokéAPI. Único para no tener dos veces la misma Poké Ball. */
  apiSlug     String?  @unique
  /** La imagen ya reducida (data URL), venga de la lista o subida a mano */
  image       String?
  createdAt   DateTime @default(now())

  options ItemOption[]
  entries BagEntry[]
  uses    BagUse[]
}

/**
 * Una de las cosas entre las que se elige al gastar un objeto: "Captura extra"
 * lleva dentro las tres rutas que puedes repetir, y al usarlo eliges una.
 * Un objeto sin opciones se gasta directamente, sin preguntar nada.
 */
model ItemOption {
  id       String  @id @default(cuid())
  itemId   String
  name     String
  apiSlug  String?
  image    String?
  position Int     @default(0)

  item Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uses BagUse[] @relation("UsoElegido")

  @@index([itemId, position])
}

/**
 * Lo que alguien tiene en la bolsa. Solo lo ve su dueño y los administradores,
 * que son los únicos que pueden añadir y quitar.
 */
model BagEntry {
  id            String   @id @default(cuid())
  participantId String
  itemId        String
  quantity      Int      @default(1)
  /** Apunte del administrador: de dónde salió, hasta cuándo vale… */
  note          String?
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Un objeto ocupa una fila con su cantidad, no una fila por unidad
  @@unique([participantId, itemId])
  @@index([participantId])
}

/**
 * Que alguien haya gastado un objeto. Es lo que sale en el muro de actividad:
 * la bolsa es privada, pero **usar** algo se anuncia, que para eso cuenta.
 *
 * Guarda copiado el nombre de lo usado porque los enlaces se ponen a null si el
 * objeto desaparece del catálogo: el historial tiene que aguantar eso.
 */
model BagUse {
  id            String   @id @default(cuid())
  participantId String
  itemId        String?
  itemName      String
  optionId      String?
  optionName    String?
  usedAt        DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  item        Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  option      ItemOption? @relation("UsoElegido", fields: [optionId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([usedAt])
}

// ---------------------------------------------------------------------------
// Competiciones
// ---------------------------------------------------------------------------

model Competition {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  // Juego / edición sobre la que se juega ("Pokémon HeartGold y SoulSilver")
  game           String?
  // Modalidad ("Random", "Nuzlocke clásico", ...)
  modality       String?
  description    String?
  // "ACTIVE" | "ARCHIVED"
  status         String    @default("ACTIVE")
  // Puntos con los que arranca cada participante
  startingPoints Int       @default(5)
  maxPlayers     Int       @default(6)
  /**
   * Si la diferencia de pokémon de los combates de reto cuenta para el
   * desempate de la clasificación. Los retos nunca dan puntos; esto solo
   * decide si su diferencia entra en el tercer criterio.
   */
  challengeDiffCounts Boolean @default(false)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById String?
  createdBy   User?   @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  participants Participant[]
  rules        RuleSection[]
  levelCaps    LevelCap[]
  matchdays    Matchday[]
  roulettes    Roulette[]
  notes        Note[]
  pointEntries PointEntry[]
  finalFour    FinalFour?
  tickets      RouletteTicket[]
  challenges   ChallengeMatch[]
}

model Participant {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  // Nombre mostrado dentro de esta competición (mote/nick del jugador)
  displayName   String
  // Edición del juego que le tocó ("HeartGold" / "SoulSilver")
  gameVersion   String?
  color         String   @default("#6366f1")
  // Admin de esta competición concreta (puede editar reglas, ruletas y puntos)
  isAdmin       Boolean  @default(false)
  joinedAt      DateTime @default(now())

  // Pokémon as: el representante del jugador en esta edición. Va aquí y no en
  // User para que cada competición conserve el suyo cuando se archiva.
  aceSpecies     String?
  aceNickname    String?
  // Por qué es su as. Opcional, para lucirse en la ficha.
  aceReason      String?
  aceImage       String?
  aceDetailImage String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  deaths       Death[]
  pointEntries PointEntry[]
  gymClears    GymClear[]
  gymVideos    GymVideo[]
  notesAbout   Note[]       @relation("NoteSubject")
  matchesAsA   Match[]      @relation("MatchPlayerA")
  matchesAsB   Match[]      @relation("MatchPlayerB")
  matchesWon   Match[]      @relation("MatchWinner")
  finalsWon    FinalMatch[] @relation("FinalMatchWinner")
  hallOfFame   HallOfFameEntry[]
  tickets      RouletteTicket[]
  matchTeams   MatchPokemon[]
  mvpVotes     MvpVote[]    @relation("MvpVoter")
  favorites    FavoritePokemon[]
  challengesA  ChallengeMatch[] @relation("ChallengePlayerA")
  challengesB  ChallengeMatch[] @relation("ChallengePlayerB")
  challengesWon ChallengeMatch[] @relation("ChallengeWinner")
  bag          BagEntry[]
  bagUses      BagUse[]

  @@unique([competitionId, userId])
  @@index([competitionId])
}

// ---------------------------------------------------------------------------
// Reglas y level caps
// ---------------------------------------------------------------------------

model RuleSection {
  id            String   @id @default(cuid())
  competitionId String
  title         String
  // Texto de la sección. Se admite una sintaxis ligera: líneas que empiezan por
  // "- " se renderizan como lista y **texto** en negrita.
  body          String
  // Agrupador opcional ("Básicas", "Jornadas", "Puntos"...)
  category      String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, position])
}

model LevelCap {
  id            String  @id @default(cuid())
  competitionId String
  // Nombre del líder / hito ("Pegaso", "Alto Mando", "Liga Pokémon")
  label         String
  cap           Int
  // "GYM" | "ELITE_FOUR" | "CHAMPION" | "OTHER"
  kind          String  @default("GYM")
  badge         String?
  notes         String?
  // Medallas o retratos: si hay más de una, se van alternando con un fundido.
  // Cada una es una URL o una imagen subida (data URL ya redimensionada).
  images        String[] @default([])
  // Legado de cuando solo se admitía una imagen. Se sigue leyendo como
  // respaldo si "images" está vacío, y se vacía al guardar desde el formulario.
  image         String?
  position      Int     @default(0)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  clears      GymClear[]
  videos      GymVideo[]

  @@index([competitionId, position])
}

// Marca de "gimnasio superado" por participante, para saber quién va por dónde
model GymClear {
  id            String   @id @default(cuid())
  participantId String
  levelCapId    String
  clearedAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  levelCap    LevelCap    @relation(fields: [levelCapId], references: [id], onDelete: Cascade)

  @@unique([participantId, levelCapId])
}

/**
 * El vídeo de cómo alguien se pasó un gimnasio. **Solo el enlace de YouTube**:
 * un combate son unos 115 MB y la base de datos gratis entera son 500 MB, así
 * que los vídeos viven fuera y aquí queda la dirección.
 *
 * Va en su propia tabla y no dentro de `GymClear` a propósito: si colgara de
 * ahí, desmarcar la casilla de "superado" por un descuido se llevaría por
 * delante el enlace. Así el vídeo sobrevive a que alguien toque la casilla.
 */
model GymVideo {
  id            String   @id @default(cuid())
  participantId String
  levelCapId    String
  url           String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  levelCap    LevelCap    @relation(fields: [levelCapId], references: [id], onDelete: Cascade)

  // Uno por persona y gimnasio
  @@unique([participantId, levelCapId])
  @@index([levelCapId])
}

// ---------------------------------------------------------------------------
// Muertes
// ---------------------------------------------------------------------------

model Death {
  id            String   @id @default(cuid())
  participantId String
  // Especie del pokémon ("Typhlosion")
  species       String
  // Mote obligatorio en el locke
  nickname      String?
  level         Int?
  // Dónde murió (ruta, gimnasio, combate de jornada...)
  location      String?
  // Qué lo mató
  cause         String?
  diedAt        DateTime @default(now())
  notes         String?
  // Sprite pequeño que se ve en la caja. Se elige al registrar la baja.
  boxImage      String?
  // Imagen grande del panel de detalle. Es independiente de la de la caja.
  detailImage   String?
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Notas privadas (solo visibles para su autor)
// ---------------------------------------------------------------------------

model Note {
  id            String   @id @default(cuid())
  competitionId String
  authorId      String
  // Sub-apartado: sobre qué jugador va la nota. null = notas generales.
  subjectId     String?
  title         String
  body          String   @default("")
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject     Participant? @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([competitionId, authorId])
}

// ---------------------------------------------------------------------------
// Puntos
// ---------------------------------------------------------------------------

// Historial de movimientos de puntos. El total de un participante es
// competition.startingPoints + suma de todos sus deltas.
model PointEntry {
  id            String   @id @default(cuid())
  competitionId String
  participantId String
  delta         Int
  reason        String
  createdById   String?
  createdAt     DateTime @default(now())
  // Si el punto viene de ganar un combate de jornada, se enlaza con él para
  // poder rehacerlo si se corrige el resultado.
  sourceMatchId String?  @unique

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("PointAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([competitionId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Jornadas y combates
// ---------------------------------------------------------------------------

model Matchday {
  id            String    @id @default(cuid())
  competitionId String
  label         String
  // Hito al que corresponde ("2da medalla", "Endgame")
  milestone     String?
  position      Int       @default(0)
  playedAt      DateTime?
  // Puntos que se llevan los ganadores de esta jornada
  pointsForWin  Int       @default(1)

  /**
   * Por qué el MVP es el MVP. Lo escribe un administrador; el pokémon en sí no
   * se guarda aquí, sale de la votación.
   */
  mvpReason     String?
  /**
   * Solo se usa cuando la votación acaba empatada arriba: el administrador
   * elige entre los empatados y ese desempate manda. Si luego los votos
   * deshacen el empate, se ignora.
   */
  mvpTiebreakId String?

  competition Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches     Match[]
  mvpVotes    MvpVote[]
  mvpTiebreak MatchPokemon? @relation("MatchdayTiebreak", fields: [mvpTiebreakId], references: [id], onDelete: SetNull)

  @@index([competitionId, position])
}

model Match {
  id             String    @id @default(cuid())
  matchdayId     String
  participantAId String
  participantBId String
  winnerId       String?
  // Diferencia de pokémon del combate (desempate de la clasificación)
  pokemonDiff    Int?
  /**
   * Enlace a la repetición del combate (Showdown, un vídeo…). Lo pega un
   * administrador; si no hay, no sale el botón de verlo.
   */
  replayUrl      String?
  playedAt       DateTime?
  notes          String?
  position       Int       @default(0)

  matchday     Matchday    @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  participantA Participant @relation("MatchPlayerA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB Participant @relation("MatchPlayerB", fields: [participantBId], references: [id], onDelete: Cascade)
  winner       Participant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  team         MatchPokemon[]

  @@index([matchdayId])
}

/**
 * Un pokémon del equipo que un jugador sacó en un combate concreto. Los pone el
 * administrador y son los candidatos a MVP de esa jornada.
 */
model MatchPokemon {
  id            String  @id @default(cuid())
  /**
   * De qué combate es el equipo. Va uno de los dos, nunca los dos: los de
   * jornada apuntan a `matchId` y los de reto a `challengeMatchId`. Se comparte
   * la tabla para poder reutilizar el mismo editor de equipos.
   */
  matchId          String?
  challengeMatchId String?
  participantId String
  species       String
  nickname      String?
  /** Sprite de caja de Pokémon HOME: es el que se ve en la lista del combate. */
  boxImage      String?
  /** Ilustración oficial. Solo se usa en la ficha si gana la votación de MVP. */
  detailImage   String?
  position      Int     @default(0)

  match          Match?          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  challengeMatch ChallengeMatch? @relation(fields: [challengeMatchId], references: [id], onDelete: Cascade)
  participant    Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  votes          MvpVote[]
  tiebreakOf     Matchday[]      @relation("MatchdayTiebreak")

  @@index([matchId])
  @@index([challengeMatchId])
  @@index([participantId])
}

/**
 * Combate de reto: un pique suelto entre dos jugadores, fuera de las jornadas.
 * Lleva premio y castigo, cuenta para el historial de victorias y derrotas,
 * pero **no da puntos**. Su diferencia de pokémon solo entra en el desempate de
 * la clasificación si la competición lo tiene activado.
 */
model ChallengeMatch {
  id            String    @id @default(cuid())
  competitionId String
  participantAId String
  participantBId String
  winnerId      String?
  pokemonDiff   Int?
  /** Enlace a la repetición del combate, igual que en las jornadas. */
  replayUrl     String?
  /** Qué se lleva el ganador */
  prize         String?
  /** Qué se traga el perdedor */
  punishment    String?
  playedAt      DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  competition  Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participantA Participant  @relation("ChallengePlayerA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB Participant  @relation("ChallengePlayerB", fields: [participantBId], references: [id], onDelete: Cascade)
  winner       Participant? @relation("ChallengeWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  team         MatchPokemon[]

  @@index([competitionId])
}

/**
 * Voto de un jugador al MVP de una jornada. Uno por jugador y jornada: volver a
 * votar cambia el voto anterior en vez de sumar otro.
 */
model MvpVote {
  id             String   @id @default(cuid())
  matchdayId     String
  voterId        String
  matchPokemonId String
  createdAt      DateTime @default(now())

  matchday Matchday     @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  voter    Participant  @relation("MvpVoter", fields: [voterId], references: [id], onDelete: Cascade)
  pokemon  MatchPokemon @relation(fields: [matchPokemonId], references: [id], onDelete: Cascade)

  @@unique([matchdayId, voterId])
  @@index([matchPokemonId])
}

// ---------------------------------------------------------------------------
// Final Four y hall de la fama
// ---------------------------------------------------------------------------

/**
 * El cuadro final. Se genera cuando ya están jugadas todas las jornadas, y
 * guarda la clasificación de ese momento congelada (`seeds`): así, si después
 * se corrige algún punto, el cuadro no se recoloca a mitad del torneo.
 */
model FinalFour {
  id            String   @id @default(cuid())
  competitionId String   @unique
  /** Los 6 participantes en orden de clasificación, del 1º al 6º */
  seeds         String[]
  createdAt     DateTime @default(now())

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches     FinalMatch[]
}

/**
 * Un combate del cuadro. Los emparejamientos no se guardan: se deducen de
 * `seeds` y de quién va ganando, así que no pueden quedar incoherentes.
 * key: CROSS_A (3º-6º), CROSS_B (4º-5º), SEMI_A (1º-ganador A),
 * SEMI_B (2º-ganador B) y FINAL.
 */
model FinalMatch {
  id          String    @id @default(cuid())
  finalFourId String
  key         String
  winnerId    String?
  pokemonDiff Int?
  playedAt    DateTime?
  notes       String?

  finalFour FinalFour    @relation(fields: [finalFourId], references: [id], onDelete: Cascade)
  winner    Participant? @relation("FinalMatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([finalFourId, key])
}

/** Un pokémon del equipo con el que cada jugador termina el locke. */
model HallOfFameEntry {
  id            String   @id @default(cuid())
  participantId String
  species       String
  nickname      String?
  image         String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

/**
 * Los pokémon favoritos de un jugador en esta edición: los que le han hecho el
 * locke, estén vivos o muertos. Van en el participante y no en el usuario para
 * que cada edición conserve los suyos al archivarse, igual que el as.
 */
model FavoritePokemon {
  id            String   @id @default(cuid())
  participantId String
  species       String
  nickname      String?
  image         String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Ruleta personalizable
// ---------------------------------------------------------------------------

model Roulette {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  description   String?
  // Si es false, las opciones ya salidas se desactivan automáticamente
  allowRepeats  Boolean  @default(true)
  spinSeconds   Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  options     RouletteOption[]
  spins       RouletteSpin[]
  tickets     RouletteTicket[]

  @@index([competitionId])
}

model RouletteOption {
  id         String  @id @default(cuid())
  rouletteId String
  label      String
  // Peso relativo: una opción con peso 3 sale el triple que una de peso 1
  weight     Int     @default(1)
  color      String?
  enabled    Boolean @default(true)
  position   Int     @default(0)

  roulette Roulette       @relation(fields: [rouletteId], references: [id], onDelete: Cascade)
  spins    RouletteSpin[]

  @@index([rouletteId, position])
}

/**
 * Tickets de ruleta. Como los puntos, es un historial y no un contador: cada
 * fila suma (los que concede un administrador) o resta (el que se gasta al
 * girar), y el saldo es la suma. Así se ve quién dio qué y por qué.
 */
model RouletteTicket {
  id            String   @id @default(cuid())
  competitionId String
  participantId String
  delta         Int
  reason        String?
  /**
   * De qué ruleta es el ticket: valen solo para la suya. En la base de datos
   * es opcional para no romper las filas de la primera versión, en la que los
   * tickets servían para cualquiera; el código lo exige siempre y esas filas
   * antiguas no cuentan para ninguna ruleta.
   */
  rouletteId    String?
  createdById   String?
  createdAt     DateTime @default(now())

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  roulette    Roulette?    @relation(fields: [rouletteId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("TicketAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([competitionId])
  @@index([participantId])
}

model RouletteSpin {
  id          String   @id @default(cuid())
  rouletteId  String
  optionId    String?
  // Copia del texto por si luego se borra o renombra la opción
  optionLabel String
  spunById    String?
  note        String?
  createdAt   DateTime @default(now())

  roulette Roulette        @relation(fields: [rouletteId], references: [id], onDelete: Cascade)
  option   RouletteOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  spunBy   User?           @relation(fields: [spunById], references: [id], onDelete: SetNull)

  @@index([rouletteId])
}

/**
 * Una copia de seguridad completa: todas las tablas menos esta, en JSON,
 * comprimido y guardado como texto.
 *
 * **No tiene ninguna relación con el resto del modelo, y es a propósito.** Al
 * restaurar se vacían todas las tablas; si esta colgara de `User`, el vaciado
 * se llevaría por delante las copias justo cuando hacen falta. Por eso el autor
 * se guarda como nombre suelto y no como enlace.
 */
model Backup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /** "auto" (la del día), "manual" (a mano) o "previa" (antes de restaurar) */
  kind      String   @default("auto")
  /** Quién la pidió, por su nombre. Suelto: ver el comentario de arriba. */
  authorName String?
  /** Cuántas filas de cada tabla, para enseñarlo sin abrir el fichero */
  summary   String
  /** Lo que ocupa el JSON sin comprimir, en bytes */
  rawSize   Int
  /** El volcado entero: JSON comprimido con gzip y pasado a base64 */
  payload   String

  @@index([createdAt])
}
