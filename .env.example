# Base de datos PostgreSQL. En Neon te dan una cadena así al crear el proyecto.
# Usa la "pooled": la que lleva "-pooler" en el nombre del servidor.
DATABASE_URL="postgresql://usuario:contraseña@host-pooler.neon.tech/hexaapp?sslmode=require"

# La misma pero SIN "-pooler". Solo se usa para crear las tablas al publicar,
# porque eso no funciona a través del pooler. Si no la pones, se usa la de
# arriba, que es lo correcto cuando no se usa pooler.
DIRECT_URL="postgresql://usuario:contraseña@host.neon.tech/hexaapp?sslmode=require"

# Clave para firmar las cookies de sesión. Cambiala por una cadena larga y aleatoria.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria-en-produccion"

# Contraseña inicial que el seed asigna a todos los usuarios de ejemplo
SEED_PASSWORD="hexalocke"
