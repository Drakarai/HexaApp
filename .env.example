# Base de datos SQLite (fichero local)
DATABASE_URL="file:./dev.db"

# Clave para firmar las cookies de sesión. Cambiala por una cadena larga y aleatoria.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria-en-produccion"

# Contraseña inicial que el seed asigna a todos los usuarios de ejemplo
SEED_PASSWORD="hexalocke"
